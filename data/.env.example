# Prompt AI /data service environment
# Copy to .env and fill in values before running locally.
# The service refuses to start if a required value is missing or malformed.

# Required. The only OpenAI key in the whole system lives here.
OPENAI_API_KEY="sk-..."

# Required, at least 16 characters. /api sends this as
# Authorization: Bearer <secret>. Must match API_SHARED_SECRET in /api.
API_SHARED_SECRET="change-me-to-a-long-random-string"

PORT=8000

# Optional, these are the defaults.
OPENAI_MODEL="gpt-4o"
OPENAI_FAST_MODEL="gpt-4o-mini"
OPENAI_TRANSCRIBE_MODEL="whisper-1"
# Live transcription over the streaming socket.
OPENAI_REALTIME_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"
REALTIME_MAX_SECONDS=180
OPENAI_TIMEOUT_SECONDS=90

# Optional per step model overrides, each falls back to OPENAI_MODEL. Defaults are
# deliberate: every step was tested against the small model, see COST_AUDIT.md.
# OPENAI_INTENT_MODEL=
# OPENAI_CONSTRUCT_MODEL=
# OPENAI_ANSWER_MODEL=
# OPENAI_VISION_MODEL=
# OPENAI_SEARCH_MODEL=
