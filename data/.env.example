# Prompt AI /data service environment
# Copy to .env and fill in values before running locally.

PORT=8000

# Shared secret that /api must send in Authorization: Bearer <key>
# Must match DATA_SERVICE_API_KEY in /api
DATA_SERVICE_API_KEY="change-me-random-32-char-string"

# OpenAI key for structured prompt generation (falls back to local heuristic)
OPENAI_API_KEY="sk-..."
