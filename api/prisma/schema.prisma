// Prompt AI - Prisma Schema
// Target: Supabase PostgreSQL
// Run `npm run db:generate` after any schema change.
// Run `npm run db:migrate` to apply changes to the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DATABASE_DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  otpTokens     OtpToken[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// OTP tokens
// One active token per user at a time. Previous tokens are marked used when
// a new one is issued.
// ---------------------------------------------------------------------------

model OtpToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_tokens")
}

// ---------------------------------------------------------------------------
// Refresh tokens
// Hashed and stored. Rotated on every use. Revoked on logout.
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Chat sessions
// user_id stores the Supabase auth.users UUID (not the Prisma User cuid).
// Accessed by the Next.js /api/chat route via Supabase client (snake_case).
// ---------------------------------------------------------------------------

model ChatSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String    @default("New Chat")
  model     String    @default("claude-3-5-sonnet")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  messages  Message[]

  @@index([userId])
  @@map("chat_sessions")
}

// ---------------------------------------------------------------------------
// Messages
// ---------------------------------------------------------------------------

model Message {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  role      String      // "user" | "assistant"
  content   String
  metadata  Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at")

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}
