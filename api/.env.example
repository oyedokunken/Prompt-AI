# -------------------------------------------------------
# Prompt AI API - Environment Variables
# Copy to .env and fill in all values before starting.
# Never commit .env to version control.
# -------------------------------------------------------

# Server
NODE_ENV=development
PORT=3001

# -------------------------------------------------------
# Database (Supabase PostgreSQL via Prisma)
# Get both from: Supabase dashboard > Settings > Database
# Use the "connection pooling" URL for DATABASE_URL
# Use the "direct connection" URL for DATABASE_DIRECT_URL
# -------------------------------------------------------
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# -------------------------------------------------------
# Supabase
# Get from: Supabase dashboard > Settings > API
# -------------------------------------------------------
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# -------------------------------------------------------
# JWT
# Generate secrets with: node -e "require('crypto').randomBytes(64).toString('hex')"
# -------------------------------------------------------
JWT_ACCESS_SECRET="change-me-min-32-chars-random-hex"
JWT_REFRESH_SECRET="change-me-min-32-chars-random-hex-different"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# -------------------------------------------------------
# OTP
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
# -------------------------------------------------------
OTP_PEPPER="change-me-32-char-random-hex-string"

# -------------------------------------------------------
# SMTP / Nodemailer (optional — server starts without these)
# For dev: use Mailtrap (https://mailtrap.io) or Ethereal
# For prod: use Resend, Postmark, or AWS SES SMTP
# -------------------------------------------------------
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-mailtrap-user"
SMTP_PASS="your-mailtrap-pass"
EMAIL_FROM="noreply@prompt.ai"
EMAIL_FROM_NAME="Prompt AI"

# -------------------------------------------------------
# App URLs
# -------------------------------------------------------
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
ALLOWED_ORIGINS="http://localhost:3000"

# -------------------------------------------------------
# Data service (the only service that calls a model provider)
# Local dev: http://localhost:8000
# Production: the deployed /data service URL on Render
# API_SHARED_SECRET must match API_SHARED_SECRET in /data, min 16 chars.
# There is deliberately no OpenAI key here, only /data holds one.
# -------------------------------------------------------
DATA_SERVICE_URL="http://localhost:8000"
API_SHARED_SECRET="change-me-to-a-long-random-string"
